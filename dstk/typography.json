{
  "$description": "타이포 스케일 2계열 — ① 시거리(2m/3m·1m): 피그마 HiNAS Control DNV TA 실측(4K 캔버스 기준 px), ISO 8468 6.3.4.1 연동(regulations/control.md), TODO 값은 실측 대기·빌드 방출 생략. ② desktop-*: 피그마 Desktop 텍스트 스타일 40종 실측(2026-09-02 편입 — Inter · 사이즈당 4무게 중 weight는 역할별 대표 무게). 핸드오프 typography.css의 원천.",
  "desktop-caption-xs": { "$type": "typography", "$value": { "size": "10px", "lineHeight": "16px", "weight": "400" } },
  "desktop-caption-s":  { "$type": "typography", "$value": { "size": "11px", "lineHeight": "16px", "weight": "400" } },
  "desktop-caption-m":  { "$type": "typography", "$value": { "size": "12px", "lineHeight": "16px", "weight": "400" } },
  "desktop-body":       { "$type": "typography", "$value": { "size": "13px", "lineHeight": "20px", "weight": "400" } },
  "desktop-title-xs":   { "$type": "typography", "$value": { "size": "14px", "lineHeight": "20px", "weight": "500" } },
  "desktop-title-s":    { "$type": "typography", "$value": { "size": "16px", "lineHeight": "24px", "weight": "600" } },
  "desktop-title-m":    { "$type": "typography", "$value": { "size": "18px", "lineHeight": "24px", "weight": "600" } },
  "desktop-title-l":    { "$type": "typography", "$value": { "size": "20px", "lineHeight": "24px", "weight": "600" } },
  "desktop-title-xl":   { "$type": "typography", "$value": { "size": "24px", "lineHeight": "28px", "weight": "700" } },
  "desktop-display-xs": { "$type": "typography", "$value": { "size": "28px", "lineHeight": "32px", "weight": "700" } },
  "2m-caption": { "$type": "typography", "$value": { "size": "31px" } },
  "2m-body1":   { "$type": "typography", "$value": { "size": "34px" } },
  "2m-body2":   { "$type": "typography", "$value": { "size": "38px", "weight": "700", "family": "mono" }, "$note": "Bold Mono" },
  "2m-title1":  { "$type": "typography", "$value": { "size": "44px", "weight": "700" }, "$note": "Bold" },
  "1m-caption": { "$type": "typography", "$value": { "size": "16px" } },
  "1m-body1":   { "$type": "typography", "$value": "TODO" },
  "1m-body2":   { "$type": "typography", "$value": "TODO" },
  "1m-title1":  { "$type": "typography", "$value": "TODO" }
}
